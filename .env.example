# Local development environment variables
# DO NOT commit real credentials — this file is gitignored.
# Copy to .env and fill in values before running docker compose or the services.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=frauddb
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud

# ── Spring datasource (used by all services) ──────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/frauddb
SPRING_DATASOURCE_USERNAME=fraud
SPRING_DATASOURCE_PASSWORD=fraud

# ── Kafka ─────────────────────────────────────────────────────────────────────
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Rules service Basic Auth ──────────────────────────────────────────────────
RULES_ANALYST_USER=analyst
RULES_ANALYST_PASSWORD=analyst

# ── Case management service users ─────────────────────────────────────────────
CASE_ANALYST_USER=analyst1
CASE_ANALYST_PASSWORD=analyst1pass
CASE_ADMIN_USER=admin1
CASE_ADMIN_PASSWORD=admin1pass

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin
